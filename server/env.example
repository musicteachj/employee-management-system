# Environment configuration for Employee Management System (Backend)

# "development" or "production"
ENVIRONMENT=development

# MongoDB connection string (placeholder for now)
MONGODB_URL=mongodb://localhost:27017

# Database name
DATABASE_NAME=data-base-name

# Comma-separated CORS origins
CORS_ORIGINS=http://localhost:5173

# JWT Settings
# IMPORTANT: Generate a secure random key for production!
# You can generate one with: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI / Anthropic Settings
# Get a key from https://console.anthropic.com/ — keep it server-side only.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
AI_MODEL=claude-sonnet-4-6
AI_MAX_ITERATIONS=5
AI_DAILY_CAP=100
AI_MONTHLY_CAP=1000


